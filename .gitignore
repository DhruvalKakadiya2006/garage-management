# ──────────────────────────────────────────────────────────────
# DomPDF Font Cache
# ──────────────────────────────────────────────────────────────
# Regenerated on first render from @font-face rules in
# resources/views/pdf/job-card.blade.php
# Only source OpenSans-*.ttf files and LICENSE.txt are tracked
/storage/fonts/installed-fonts.json
/storage/fonts/Helvetica.afm.json
/storage/fonts/Helvetica-Bold.afm.json
/storage/fonts/*.ufm
/storage/fonts/*.ufm.json
/storage/fonts/open_sans_*.ttf

